{{!-- template: post-archive | 2019.05.28--}}

{{!< default}}

{{#post}}
<section class="section">
    <div class="container">
        <h1 class="title has-text-centered is-montserrat">{{> "icons/archive"}} {{title}}</h1>     
    </div>
</section>
<section class="section is-paddingless-top is-mobile-paddingless">
    <div class="columns">
        <div class="column is-hidden-touch is-1-desktop is-1-widescreen is-2-fullhd"></div>
        <div class="column is-12-tablet is-10-desktop is-10-widescreen is-8-fullhd">
            <article class="{{post_class}} single-article">
                <div class="box is-paddingless is-shadowless is-full-mobile is-centered is-clipped">
                    <section class="post-wrap is-vpadding-15">
                        <div class="spacing-15 is-hidden-mobile"></div>
                        <div class="post-content">
                            {{#get "posts" limit="100" include="authors" order="published_at desc" as |archive_posts archive_meta|}}
                                {{t "There are {total} posts in total" total=archive_meta.total}}
                                <ul class="post-archive">
                                    {{#foreach archive_posts}}
                                    <li class="post-archive-item" data-year="{{date format=(t 'YYYY')}}" data-month="{{date format=(t 'MMMM')}}">
                                        <div class="date">
                                            <time class="button is-static is-size-7" datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format=(t "MMM DD")}}</time>
                                        </div>
                                        <div class="subtitle">
                                            <a href="{{url}}">{{title}}</a>
                                            {{#if featured}}<span style="color:var(--main-color)" title="{{t "Featured"}}">{{> "icons/star"}}</span>{{/if}}
                                            <span class="authors"> - {{authors separator=", "}}</span>
                                        </div>
                                    </li>
                                    {{/foreach}}
                                </ul>
                            {{/get}}
                        </div>
                    </section>
                </div>
            </article>
        </div>
        <div class="column is-hidden-touch"></div>
    </div>
</section>
{{/post}}


