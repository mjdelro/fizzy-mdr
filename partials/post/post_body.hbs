<div class="has-2-ends is-ui-font is-uppercase is-size-7">
    <div class="end date"><time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format=(t "DD MMMM YYYY")}}</time></div>
    <div class="end reading_time">{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</div>
</div>

<h1 class="title is-ui-font">{{title}}</h1>

{{#has tag="count:>0"}}
    <div class="buttons tags has-text-weight-semibold">
        <a href="/tags/" class="button category-pill category-pill--icon category-pill--surface post-tag-archive-link" title="Browse all tags" aria-label="Browse all tags">
            {{#has tag="count:1"}}{{> "icons/tag"}}{{/has}}
            {{#has tag="count:>1"}}{{> "icons/tags"}}{{/has}}
        </a>
        {{#foreach tags}}
            <a href="{{url}}" class="button category-pill category-pill--surface">{{name}}</a>
        {{/foreach}}
    </div>
{{/has}}

<div class="content post-content is-size-6-mobile is-body-font">{{content}}</div>

{{> "post/post_author"}}
