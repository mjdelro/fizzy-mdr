{{#if @custom.show_showcase}}
<section class="section showcase" id="showcase">
    <div class="columns">
        <div class="column is-hidden-touch is-1-desktop is-1-widescreen is-2-fullhd"></div>
        <div class="column is-12-tablet is-10-desktop is-10-widescreen is-8-fullhd">
            <div class="columns">
                <div class="column is-7">
                    <div class="carousel" id="carousel-home" aria-label="Featured posts">
                        {{#get "posts" limit="6" include="tags" filter="tags:[hash-carousel]" as |carousel|}}
                        {{#foreach carousel}}
                        <article class="carousel-item box has-shadow-lift can-scale{{#has number="1"}} is-active{{/has}}">
                            {{#if feature_image}}
                            <img class="showcase-image" src="{{img_url feature_image size="large"}}"
                                 srcset="{{img_url feature_image size="small"}} 300w, {{img_url feature_image size="medium"}} 600w, {{img_url feature_image size="large"}} 900w, {{img_url feature_image size="wide"}} 1200w"
                                 sizes="(max-width: 768px) 100vw, 58vw" alt="{{feature_image_alt}}"
                                 {{#has number="1"}}loading="eager" fetchpriority="high"{{else}}loading="lazy"{{/has}}>
                            {{/if}}
                            <a href="{{url}}" rel="bookmark" class="link-block" aria-label="{{title}}"></a>
                            <div class="carousel-meta bg-grad-b">
                                {{#primary_tag}}<div class="carousel-tag"><a href="{{url}}" class="is-montserrat">{{name}}</a></div>{{/primary_tag}}
                                <a href="{{url}}"><h2 class="is-size-4 is-size-5-mobile is-margin-bottom-05 has-text-white has-text-weight-semibold has-text-shadow-black">{{title}}</h2></a>
                            </div>
                        </article>
                        {{/foreach}}
                        {{/get}}
                    </div>
                </div>

                <div class="column is-5">
                    {{#get "posts" limit="2" include="tags" filter="tags:-hash-carousel" order="featured desc,published_at desc" as |top-featured|}}
                    <div class="top-featured">
                        {{#foreach top-featured}}
                        <article class="tf-item box has-shadow-lift can-scale">
                            {{#if feature_image}}
                            <img class="showcase-image" src="{{img_url feature_image size="medium"}}"
                                 srcset="{{img_url feature_image size="small"}} 300w, {{img_url feature_image size="medium"}} 600w, {{img_url feature_image size="large"}} 900w"
                                 sizes="(max-width: 768px) 100vw, 42vw" alt="{{feature_image_alt}}" loading="lazy">
                            {{/if}}
                            {{#if featured}}<span class="featured-label is-montserrat" style="right:5px;top:5px;padding:0 3px;" title="{{t "Featured"}}">{{> "icons/star"}} <span>{{t "Featured"}}</span></span>{{/if}}
                            <a href="{{url}}" rel="bookmark" class="link-block" aria-label="{{title}}"></a>
                            <div class="tf-meta bg-grad-b">
                                {{#primary_tag}}<div class="tf-tag"><a href="{{url}}" class="is-montserrat">{{name}}</a></div>{{/primary_tag}}
                                <a href="{{url}}"><h2 class="is-size-5 has-text-white has-text-weight-semibold has-text-shadow-black">{{title}}</h2></a>
                            </div>
                        </article>
                        {{/foreach}}
                    </div>
                    {{/get}}
                </div>
            </div>
        </div>
        <div class="column is-hidden-touch"></div>
    </div>
</section>
{{/if}}
