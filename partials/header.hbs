<header>
    <nav id="navbar" class="navbar is-white is-spaced has-shadow-thin is-ui-font is-fixed-top site-navbar" role="navigation" aria-label="Main navigation">
        <div class="column is-hidden-touch is-1-desktop is-1-widescreen is-2-fullhd"></div>
        <div class="nav-container column is-paddingless is-12-tablet is-10-desktop is-10-widescreen is-8-fullhd">
            <div class="navbar-brand">
                {{#if @site.logo}}
                    <div class="navbar-item logo">
                        <a href="{{@site.url}}" aria-label="{{@site.title}} home">
                            <img src="{{@site.logo}}" alt="{{@site.title}}" title="{{@site.title}} - {{@site.description}}" height="28">
                        </a>
                    </div>
                {{else}}
                    <div class="navbar-item text-logo">
                        <a class="align-vcentered" href="{{@site.url}}" title="{{@site.title}} - {{@site.description}}">
                            {{#if @site.icon}}<img src="{{@site.icon}}" alt="" width="48" height="48">{{/if}}
                            {{@site.title}}
                        </a>
                    </div>
                {{/if}}

                <button class="header-control theme-toggle theme-toggle-mobile navbar-item is-hidden-desktop" type="button" aria-label="Switch to dark mode" title="Switch to dark mode">
                    {{> "icons/moon"}}
                    {{> "icons/sun"}}
                    <span class="is-sr-only theme-toggle-text">Switch to dark mode</span>
                </button>

                <button class="navbar-burger burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="navbarPrimary" data-target="navbarPrimary">
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                </button>
            </div>

            <div id="navbarPrimary" class="navbar-menu">
                <div class="navbar-end">
                    {{#if @site.navigation}}{{navigation}}{{/if}}

                    <div class="navbar-item header-control-wrap">
                        <button class="header-control search-button" type="button" data-ghost-search aria-label="{{t "Search"}}" title="{{t "Search"}}">
                            {{> "icons/search"}}
                            <span class="is-sr-only">{{t "Search"}}</span>
                        </button>
                    </div>

                    <div class="navbar-item header-control-wrap is-hidden-touch">
                        <button class="header-control theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode">
                            {{> "icons/moon"}}
                            {{> "icons/sun"}}
                            <span class="is-sr-only theme-toggle-text">Switch to dark mode</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="column is-hidden-touch navbar-end-spacer"></div>
    </nav>
</header>
