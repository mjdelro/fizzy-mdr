<article class="{{post_class}} box post-list-card is-paddingless is-clipped has-shadow-lift margin-bottom-25 can-scale">
    <div class="columns post-card is-marginless">
        {{#if feature_image}}
        <a class="column is-paddingless post-list-card-image-link" href="{{url}}" title="{{title}}">
            <div class="featured-image">
                <img class="card-feature-image" src="{{img_url feature_image size="medium"}}"
                     srcset="{{img_url feature_image size="small"}} 300w, {{img_url feature_image size="medium"}} 600w, {{img_url feature_image size="large"}} 900w"
                     sizes="(max-width: 768px) 100vw, 38vw" alt="{{feature_image_alt}}" loading="lazy">
            </div>
        </a>
        <div class="column is-7 is-paddingless">
        {{else}}
        <div class="column is-12 is-paddingless">
        {{/if}}
            <div class="post-info">
                {{#if featured}}
                <span class="featured-label {{#if feature_image}}has-img{{else}}no-img{{/if}} is-ui-font" title="{{t "Featured"}}">{{> "icons/star"}} <span>{{t "Featured"}}</span></span>
                {{/if}}

                <div class="level is-mobile is-ui-font is-uppercase is-margin-bottom-1">
                    <div class="level-left">
                        {{#primary_tag}}<div class="level-item"><div class="buttons are-small"><a href="{{url}}" class="button is-light has-text-weight-semibold">{{name}}</a></div></div>{{/primary_tag}}
                        <div class="level-item is-size-7"><time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format=(t "DD MMMM YYYY")}}</time></div>
                    </div>
                </div>

                <a href="{{url}}" class="is-ui-font has-text-black"><h2 class="title is-3 is-size-5-mobile is-margin-bottom-1">{{title}}</h2></a>
                <p class="post-card-excerpt {{#if feature_image}}is-hidden-mobile{{else}}is-size-7-mobile is-margin-bottom-1{{/if}}">{{excerpt words="38"}}</p>
            </div>
        </div>
    </div>
</article>
