<footer class="footer is-centered">
    <div class="content has-text-centered">
        <p class="copyright">
            &copy; {{date format="YYYY"}}
            <a href="{{@site.url}}"><strong class="has-text-grey-darker">{{@site.title}}</strong></a>
        </p>

        <nav class="footer-socials" aria-label="Social profiles">
            <div class="footer-social-links">
                <a class="footer-social-link" href="https://github.com/mjdelro" target="_blank" rel="me noopener noreferrer" aria-label="GitHub" title="GitHub">
                    {{> "icons/github"}}
                    <span>GitHub</span>
                </a>

                <a class="footer-social-link" href="https://www.linkedin.com/in/michaeljdelrosario" target="_blank" rel="me noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
                    {{> "icons/linkedin"}}
                    <span>LinkedIn</span>
                </a>

                <a class="footer-social-link" href="https://www.twitch.tv/mikey_247" target="_blank" rel="me noopener noreferrer" aria-label="Twitch" title="Twitch">
                    {{> "icons/twitch"}}
                    <span>Twitch</span>
                </a>

                <a class="footer-social-link" href="https://ko-fi.com/mikey_247" target="_blank" rel="me noopener noreferrer" aria-label="Ko-fi" title="Ko-fi">
                    {{> "icons/kofi"}}
                    <span>Ko-fi</span>
                </a>
            </div>
        </nav>

        <div class="declare has-text-grey site-license" xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/">
            <p>
                <a property="dct:title" rel="cc:attributionURL" href="{{@site.url}}">{{@site.title}}</a>
                by
                <span property="cc:attributionName"><a href="mailto:me@michaeldelrosar.io">Michael del Rosario</a></span>
                is licensed under<br>
                <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="license noopener noreferrer">Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International</a>
            </p>

            <p class="cc-icons" aria-label="Creative Commons BY-NC-SA 4.0">
                <img src="https://mirrors.creativecommons.org/presskit/icons/cc.svg" alt="Creative Commons" loading="lazy">
                <img src="https://mirrors.creativecommons.org/presskit/icons/by.svg" alt="Attribution" loading="lazy">
                <img src="https://mirrors.creativecommons.org/presskit/icons/nc.svg" alt="NonCommercial" loading="lazy">
                <img src="https://mirrors.creativecommons.org/presskit/icons/sa.svg" alt="ShareAlike" loading="lazy">
            </p>

            <p class="footer-badges" aria-label="Site badges">
                <img src="https://i.imgur.com/uNFKWgd.png" alt="" loading="lazy">
                <img src="https://i.imgur.com/UbcjzBT.png" alt="" loading="lazy">
                <img src="https://i.imgur.com/aTgStwJ.png" alt="" loading="lazy">
                <img src="https://i.imgur.com/myc5A2Q.png" alt="" loading="lazy">
            </p>
