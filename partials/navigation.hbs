{{#foreach navigation}}
    {{#match label "GitHub"}}
    {{else}}
        {{#match label "LinkedIn"}}
        {{else}}
            <a class="navbar-item{{#if current}} nav-current{{/if}}" href="{{url absolute="true"}}"{{#if current}} aria-current="page"{{/if}}>{{label}}</a>
        {{/match}}
    {{/match}}
{{/foreach}}
