<nav class="buttons has-addons is-centered" aria-label="Pagination">
    {{#if prev}}
        <a href="{{page_url 1}}" class="button" title="{{t "First Page"}}" aria-label="{{t "First Page"}}">«</a>
        <a href="{{page_url prev}}" class="button" title="{{t "Previous Page"}}" aria-label="{{t "Previous Page"}}">‹</a>
    {{/if}}
    <span class="button is-static" aria-current="page">{{page}} / {{pages}}</span>
    {{#if next}}
        <a href="{{page_url next}}" class="button" title="{{t "Next Page"}}" aria-label="{{t "Next Page"}}">›</a>
        <a href="{{page_url pages}}" class="button" title="{{t "Last Page"}}" aria-label="{{t "Last Page"}}">»</a>
    {{/if}}
</nav>
