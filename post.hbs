{{!< default}}

{{#post}}
<section class="section is-mobile-paddingless">
    <div class="columns">
        <div class="column is-hidden-touch is-1-desktop is-1-widescreen is-2-fullhd"></div>
        <div class="column is-12-tablet is-10-desktop is-10-widescreen is-8-fullhd">
            <article class="{{post_class}} single-article">
                {{!-- featured_image --}}
                {{#if feature_image}}
                <div class="box is-paddingless is-shadowless is-full-mobile is-centered">
                    <section class="featured-image">
                        <div class="featured-image post-hero-image-wrap">
                            <img class="post-hero-image" src="{{img_url feature_image size="wide"}}" srcset="{{img_url feature_image size="medium"}} 600w, {{img_url feature_image size="large"}} 900w, {{img_url feature_image size="wide"}} 1200w" sizes="(max-width: 1200px) 100vw, 1200px" alt="{{feature_image_alt}}" loading="eager" fetchpriority="high">
                            {{!-- featured post label --}}
                            {{#if featured}}
                            <span class="featured-label large is-montserrat" title="Featured Post">{{> "icons/star"}} {{t "Featured"}}</span>
                            {{/if}}
                        </div>
                    </section>
                {{else}}
                <div class="box is-paddingless is-shadowless is-full-mobile is-centered">
                <div class="spacing-25 is-hidden-mobile"></div>
                {{/if}}

                    <section class="post-wrap is-vpadding-15">
                        {{!-- meta --}}
                        <div class="has-2-ends is-montserrat is-uppercase is-size-7">
                            <div class="end date"><time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format=(t "DD MMMM YYYY")}}</time></div>
                            <div class="end reading_time">{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</div>
                        </div>

                        {{!-- title --}}
                        <h1 class="title is-montserrat">{{title}}</h1>

                        {{!-- tags --}}
                        {{#has tag="count:>0"}}
                        <div class="buttons tags has-text-weight-semibold">
                            <span class="button is-static is-size-7-mobile" style="padding:0 0.5em;min-width:2.5em">
                                {{#has tag="count:1"}}{{> "icons/tag"}}{{/has}}
                                {{#has tag="count:>1"}}{{> "icons/tags"}}{{/has}}
                            </span>
                            {{#foreach tags}}
                            <a href="{{url}}" class="button is-light is-size-7-mobile has-text-weight-semibold">{{name}}</a>
                            {{/foreach}}
                        </div>
                        {{/has}}

                        {{!-- content --}}
                        <div class="content post-content is-size-6-mobile is-georgia">{{content}}</div>

                        {{!-- author box --}}
                        {{> "post/post_author"}}
                        
                    </section>
                </div>
            </article>
        </div>
        {{#if @custom.show_toc}}
        <div class="column is-hidden-touch"><div id="toc"></div></div>
        {{else}}
        <div class="column is-hidden-touch"></div>
        {{/if}}
    </div>
</section>

{{#if @custom.show_toc}}{{> "post/post_toc"}}{{/if}}

{{!-- aside section (related post, prev & next) --}}
{{> "post/post_aside"}}

{{!-- post footer for js --}}
{{> "post/post_footer"}}


{{/post}}



