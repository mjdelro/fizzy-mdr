{{!< default}}

{{#post}}
<section class="hero">
    <article class="{{post_class}} single-article">
        <div class="box is-paddingless is-shadowless is-full-mobile is-centered">
            {{#if feature_image}}
                <div class="featured-image post-hero-image-wrap">
                    <img class="post-hero-image" src="{{img_url feature_image size="wide"}}" srcset="{{img_url feature_image size="medium"}} 600w, {{img_url feature_image size="large"}} 900w, {{img_url feature_image size="wide"}} 1200w" sizes="100vw" alt="{{feature_image_alt}}" loading="eager" fetchpriority="high">
                    {{#if featured}}
                        <div class="post-wrap full-width is-vpadding-15 full-width-featured-label-wrap">
                            <span class="featured-label large is-ui-font" title="{{t "Featured"}}">{{> "icons/star"}} {{t "Featured"}}</span>
                        </div>
                    {{/if}}
                </div>
            {{/if}}

            <div class="columns">
                <div class="column is-hidden-touch is-1-desktop is-1-widescreen is-2-fullhd"></div>
                <div class="column is-12-tablet is-10-desktop is-10-widescreen is-8-fullhd">
                    <div class="post-wrap full-width is-vpadding-15">
                        <div class="spacing-15 is-hidden-mobile"></div>
                        {{> "post/post_body"}}
                    </div>
                </div>
                <div class="column is-hidden-touch position-relative">
                    {{#if @custom.show_toc}}
                        {{#if feature_image}}<div id="toc-img" class="is-absolute"></div>{{else}}<div id="toc"></div>{{/if}}
                    {{/if}}
                </div>
            </div>
        </div>
    </article>
</section>
<section class="section is-vpadding-15"></section>

{{#if @custom.show_toc}}{{> "post/post_toc"}}{{/if}}
{{> "post/post_aside"}}
{{> "post/post_footer"}}
{{/post}}
