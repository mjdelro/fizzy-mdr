{{!< default}}

{{#post}}
<section class="section is-mobile-paddingless">
    <div class="columns">
        <div class="column is-hidden-touch is-1-desktop is-1-widescreen is-2-fullhd"></div>
        <div class="column is-12-tablet is-10-desktop is-10-widescreen is-8-fullhd">
            <article class="{{post_class}} single-article">
                {{#if feature_image}}
                    <div class="box is-paddingless is-shadowless is-full-mobile is-centered">
                        <section class="featured-image post-hero-image-wrap">
                            <img class="post-hero-image" src="{{img_url feature_image size="wide"}}" srcset="{{img_url feature_image size="medium"}} 600w, {{img_url feature_image size="large"}} 900w, {{img_url feature_image size="wide"}} 1200w" sizes="(max-width: 1200px) 100vw, 1200px" alt="{{feature_image_alt}}" loading="eager" fetchpriority="high">
                            {{#if featured}}<span class="featured-label large is-ui-font" title="{{t "Featured"}}">{{> "icons/star"}} {{t "Featured"}}</span>{{/if}}
                        </section>
                {{else}}
                    <div class="box is-shadowless is-full-mobile is-centered">
                {{/if}}

                    <section class="post-wrap is-vpadding-15">
                        <div class="spacing-15 is-hidden-mobile"></div>
                        {{> "post/post_body"}}
                    </section>
                </div>
            </article>
        </div>
        <div class="column is-hidden-touch"><div id="toc"></div></div>
    </div>
</section>

{{> "post/post_toc"}}
{{> "post/post_aside"}}
{{> "post/post_footer"}}
{{/post}}
