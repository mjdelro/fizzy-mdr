<!DOCTYPE html>
<html lang="{{@site.locale}}" class="has-spaced-navbar-fixed-top">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" id="theme-color-meta" content="#f6f2e9">
    <title>{{meta_title}}</title>

    <script>
        (function () {
            var storageKey = "fizzy-color-scheme";
            var pref = "system";
            var theme = "light";

            try {
                var savedTheme = window.localStorage.getItem(storageKey);
                if (savedTheme === "light" || savedTheme === "dark") {
                    pref = savedTheme;
                    theme = savedTheme;
                } else if (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    theme = "dark";
                }
            } catch (error) {
                if (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    theme = "dark";
                }
            }

            document.documentElement.setAttribute("data-theme-pref", pref);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.style.colorScheme = theme;
            document.getElementById("theme-color-meta").setAttribute("content", theme === "dark" ? "#1c1d20" : "#f6f2e9");
        }());
    </script>

    {{ghost_head}}

    <style>
        :root {
            --site-accent: {{@site.accent_color}};
            --site-accent-contrast: {{contrast_text_color @site.accent_color}};
        }
    </style>

    <link rel="stylesheet" href="{{asset 'css/fonts.css'}}">
    <link rel="stylesheet" href="{{asset 'css/base.css'}}">
    <link rel="stylesheet" href="{{asset 'css/main.css'}}">

    {{#is "post, page"}}
        <link rel="preload" as="font" type="font/woff2" href="{{asset 'fonts/charis/Charis-Regular.woff2'}}" crossorigin>
    {{/is}}

    {{#is "post"}}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.18.1/dist/katex.min.css" integrity="sha384-1vdNCNel6Tx/NQa8IR1mGOGKsbGreCkOPfbtPPnUURJ5Tu2PRVfQ/7KLZC+Pi1p1" crossorigin="anonymous" media="print" onload="this.media='all'">
        <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.18.1/dist/katex.min.css" integrity="sha384-1vdNCNel6Tx/NQa8IR1mGOGKsbGreCkOPfbtPPnUURJ5Tu2PRVfQ/7KLZC+Pi1p1" crossorigin="anonymous"></noscript>
    {{/is}}

    <link rel="stylesheet" href="{{asset 'css/custom.css'}}">
</head>
<body class="{{body_class}} has-background-light-line" data-line-numbers="{{@custom.line_numbers}}" data-search-style-url="{{asset 'css/search.css'}}"{{#is "post, page"}} data-fslightbox-js="{{asset 'js/fslightbox.js'}}"{{/is}}{{#is "post"}} data-prism-css="{{asset 'css/prism.css'}}" data-prism-js="{{asset 'js/prism.js'}}"{{/is}}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {{> "header"}}
    <main id="main-content" tabindex="-1">
        {{{body}}}
    </main>
    {{> "footer"}}

    {{ghost_foot}}

    <script defer src="{{asset 'js/main.js'}}"></script>
</body>
</html>
