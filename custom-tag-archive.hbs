{{!< default}}

{{#post}}
<section class="section tag-directory-hero is-paddingless-bottom">
    <div class="container content-measure">
        <header class="tag-directory-heading">
            <span class="tag-directory-heading-icon" aria-hidden="true">{{> "icons/tags"}}</span>
            <div>
                <p class="tag-directory-eyebrow is-ui-font">Browse topics</p>
                <h1 class="title tag-archive-title is-ui-font">{{title}}</h1>
            </div>
        </header>
        {{#if content}}
            <div class="content post-content tag-directory-intro is-size-6-mobile is-body-font">{{content}}</div>
        {{/if}}
    </div>
</section>
{{/post}}

{{#get "tags" limit="100" include="count.posts" filter="visibility:public+slug:-getting-started" order="count.posts desc"}}
<section class="section tag-directory-section">
    <div class="container">
        <div class="columns is-mobile is-multiline is-variable is-4">
            {{#foreach tags}}
                <div class="column tag-archive-item is-3-desktop is-4-tablet is-6-mobile">
                    <a class="tag-directory-card interactive-card" href="{{url}}" aria-label="View posts tagged {{name}}">
                        <div class="tag-directory-visual{{#unless feature_image}} is-placeholder{{/unless}}">
                            {{#if feature_image}}
                                <img src="{{img_url feature_image size="medium"}}" alt="" loading="lazy">
                            {{else}}
                                <span class="tag-directory-placeholder-icon" aria-hidden="true">{{> "icons/tag"}}</span>
                            {{/if}}
                        </div>
                        <div class="tag-directory-card-body">
                            <h2 class="tag-directory-name is-ui-font">{{name}}</h2>
                            {{#if description}}<p class="tag-directory-description">{{description}}</p>{{/if}}
                            <div class="tag-directory-count is-ui-font">{{plural count.posts empty=(t "No posts") singular=(t "1 post") plural=(t "% posts")}}</div>
                        </div>
                    </a>
                </div>
            {{/foreach}}
        </div>
    </div>
</section>
{{/get}}
