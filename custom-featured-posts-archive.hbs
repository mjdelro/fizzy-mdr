{{!< default}}

{{#post}}
    {{#if feature_image}}
        <section class="hero tag-list-header is-bold bg-cover-center" style="background-image: url({{img_url feature_image size="wide"}});">
    {{else}}
        <section class="hero tag-list-header is-bold bg-cover-center tag-hero-fallback">
    {{/if}}
        <div class="hero-body has-darker-modal is-ui-font">
            <div class="container has-text-centered">
                <h1 class="title is-vmargin-2 is-capitalized has-text-white is-marginless-bottom">
                    <span class="is-padding-05-15 round-border-6">{{> "icons/star"}} {{title}}</span>
                </h1>
                <div class="subtitle content is-vmargin-2 has-text-white is-centered is-margin-auto content-measure">{{content}}</div>
            </div>
        </div>
    </section>
{{/post}}

{{#get "posts" include="tags,authors" filter="featured:true" limit="100" order="published_at desc" as |featured_posts|}}
    <main class="section">
        <div class="columns">
            <div class="column is-hidden-touch is-1-desktop is-1-widescreen is-2-fullhd"></div>
            <div class="column is-12-tablet is-10-desktop is-10-widescreen is-8-fullhd">
                {{> "post-list" posts=featured_posts}}
            </div>
            <div class="column is-hidden-touch"></div>
        </div>
    </main>
{{/get}}
