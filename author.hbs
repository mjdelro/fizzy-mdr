{{!< default}}

{{#author}}
    {{#if cover_image}}
        <section class="hero tag-list-header is-bold bg-cover-center" style="background-image: url({{img_url cover_image size="wide"}});">
    {{else}}
        <section class="hero tag-list-header is-bold bg-cover-center author-hero-fallback">
    {{/if}}
        <div class="hero-body has-dark-modal is-ui-font">
            <div class="about-author container has-text-centered">
                {{#if profile_image}}
                    <figure class="image is-96x96 is-margin-auto">
                        <img class="image-squared is-rounded" src="{{img_url profile_image size="small"}}" alt="{{name}}" title="{{name}}">
                    </figure>
                {{/if}}

                <h1 class="title has-padding-05 has-text-white">{{name}}</h1>

                <div class="subtitle has-text-white">
                    <ul class="meta-info is-size-6">
                        <li class="has-text-weight-bold">{{plural ../pagination.total empty=(t "No posts") singular=(t "1 post") plural=(t "% posts")}}</li>
                        <li aria-hidden="true">|</li>
                        {{#if twitter}}<li><a href="{{twitter_url}}" class="has-text-white" target="_blank" rel="noopener noreferrer" aria-label="{{name}} on X">{{> "icons/twitter"}}</a></li>{{/if}}
                        {{#if facebook}}<li><a href="{{facebook_url}}" class="has-text-white" target="_blank" rel="noopener noreferrer" aria-label="{{name}} on Facebook">{{> "icons/facebook"}}</a></li>{{/if}}
                        {{#if website}}<li><a href="{{website}}" class="has-text-white" target="_blank" rel="noopener noreferrer" aria-label="{{name}} website">{{> "icons/link"}}</a></li>{{/if}}
                        {{#if location}}<li>{{> "icons/location"}} {{location}}</li>{{/if}}
                    </ul>
                </div>

                {{#if bio}}
                    <div class="has-text-white is-centered is-margin-auto content-measure">{{bio}}</div>
                {{/if}}
            </div>
        </div>
    </section>
{{/author}}

<main class="section">
    <div class="columns">
        <div class="column is-hidden-touch is-1-desktop is-1-widescreen is-2-fullhd"></div>
        <div class="column is-12-tablet is-10-desktop is-10-widescreen is-8-fullhd">
            {{> "post-list" posts=posts}}
        </div>
        <div class="column is-hidden-touch"></div>
    </div>
</main>

<section class="section is-padding-top-05">
    <div class="container">{{pagination}}</div>
</section>
